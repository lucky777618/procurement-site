---
// 门户页共用外壳：和营销站同一套配色与字体，但更克制、更像工作台。
const { title = 'Lucky7Link', user = null } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Lucky7Link</title>
    <link rel="preload" href="/assets/fonts/archivo-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <style>
      :root {
        --ink: #0f1a1c;
        --paper: #f3f4f0;
        --gold: #d99e26;
        --rust: #a8482c;
        --line: rgba(15, 26, 28, 0.14);
      }
      body.portal {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: Archivo, system-ui, sans-serif;
        line-height: 1.55;
      }
      .shell { max-width: 980px; margin: 0 auto; padding: 24px 20px 72px; }
      .bar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; padding: 14px 0 18px; border-bottom: 1px solid var(--line);
        font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px;
        letter-spacing: 0.04em; text-transform: uppercase;
      }
      .bar a { color: var(--ink); text-decoration: none; }
      .bar .who { opacity: 0.7; text-transform: none; letter-spacing: 0; }
      .card {
        background: #fff; border: 1px solid var(--line); padding: 22px; margin-top: 22px;
      }
      .card h2 { font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
      h1 { font-size: clamp(26px, 4vw, 38px); line-height: 1.15; margin: 28px 0 10px; letter-spacing: -0.02em; }
      .lede { max-width: 58ch; opacity: 0.78; margin: 0 0 22px; }
      label { display: block; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; margin: 16px 0 6px; }
      input {
        width: 100%; box-sizing: border-box; padding: 12px 14px; font-size: 16px;
        border: 1px solid var(--line); background: #fff; color: var(--ink);
      }
      button {
        margin-top: 22px; width: 100%; padding: 14px; font-size: 15px; cursor: pointer;
        background: var(--ink); color: var(--paper); border: 0; letter-spacing: 0.05em;
        text-transform: uppercase; font-family: 'IBM Plex Mono', ui-monospace, monospace;
      }
      button:hover { background: #22343a; }
      .err { border-left: 3px solid var(--rust); padding: 10px 14px; background: #fff; margin: 18px 0 0; font-size: 14px; }
      .fine { font-size: 14px; opacity: 0.72; margin-top: 18px; }
      .fine a { color: var(--rust); }
    </style>
  </head>
  <body class="portal">
    <div class="shell">
      <div class="bar">
        <a href="/">Lucky7Link</a>
        {user ? <span class="who">{user.email} · <a href="/portal">Portal</a> · <a href="/api/auth/signout">Sign out</a></span> : <span class="who">Customer portal</span>}
      </div>
      <slot />
    </div>
  </body>
</html>
