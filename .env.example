# 复制为 .env 后填真值。.env 不会进版本库。
# 左侧变量名要与 docs/SETUP.md 第 3 节一致。

# --- Supabase ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # 仅服务端，绝不进前端

# --- PayPal ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- LianLian（P3，商户号下来再填） ---
LIANLIAN_MERCHANT_ID=
LIANLIAN_API_KEY=
LIANLIAN_ENV=sandbox

# --- 邮件 ---
RESEND_API_KEY=
MAIL_FROM=Lucky7Link <hello@lucky7link.com>

# --- 站点 ---
PUBLIC_SITE_URL=https://lucky7link.com
