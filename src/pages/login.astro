---
import Portal from '../layouts/Portal.astro';

const error = Astro.url.searchParams.get('error') ?? '';
const email = Astro.url.searchParams.get('email') ?? '';
---
<Portal title="Sign in" user={Astro.locals.user}>
  <h1>Sign in</h1>
  <p class="lede">Track your orders, upload payment receipts and follow shipments from here.</p>

  <form method="post" action="/api/auth/signin" class="card">
    {error && <div class="err">{error}</div>}
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required value={email} autocomplete="email" />
    <label for="password">Password</label>
    <input id="password" name="password" type="password" required autocomplete="current-password" />
    <button type="submit">Sign in</button>
  </form>

  <p class="fine">No account yet? <a href="/signup">Create one</a>.</p>
</Portal>
